<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cube_petit_v3">
  <!-- General -->
  <!-- <xacro:include filename="color_property.xacro"/> -->

  <!-- <xacro:include filename="$(find
  cube_petit_description)/xacro/publish_pose/publish_pose.xacro"/>
  <xacro:include filename="$(find
  cube_petit_description)/xacro/brass_gazebo_battery/brass_gazebo_battery.xacro"/> -->

  <link name="base_link"/>
  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="base_link_reverse"/>
  <joint name="base_link_reverse_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_reverse"/>
    <origin rpy="0 0 3.1415926" xyz="0 0 0"/>
  </joint>

  <link name="respeaker_base"/>
  <joint name="respeaker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="respeaker_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.28"/>
  </joint>


  <link name="body_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find cube_petit_description)/meshes/cube_petit/body/cube_petit_v2_body.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.13725"/>
      <!-- <origin rpy="0 0 0" xyz="0 0 0.11475"/> -->
      <geometry>
        <box size="0.221 0.2225 0.2705"/>
        <!-- <box size="0.221 0.2225 0.2225"/> -->
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.00440023 0.00053314 0.15283194"/>
      <mass value="1.98239086"/>
      <inertia ixx="0.02351680" ixy="0.00001868" iyy="0.02505713" ixz="-0.00012952" iyz="-0.00004728" izz="0.02060399"/>
    </inertial>
  </link>
  <gazebo reference="body_link">
    <selfCollide>false</selfCollide>
    <maxContacts>4</maxContacts>
    <mu1 value="0.0"/>
    <kp value="150000"/>
    <kd value="0"/>
  </gazebo>

  <link name="connector_link"/>
  <joint name="connector_joint" type="fixed">
    <parent link="base_link"/>
    <child link="connector_link"/>
    <origin rpy="0 0 3.14" xyz="-0.11 0 0.025"/>
  </joint>

  <!-- lidar -->
  <joint name="laser_joint" type="fixed">
    <parent link="body_link"/>
    <child link="pacecat_link"/>
    <origin rpy="0 0 0" xyz="0.0 0 0.23975"/>
  </joint>
  <link name="pacecat_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00000000 0.00000000 0.00208424"/>
      <mass value="0.11166745"/>
      <inertia ixx="0.004391" ixy="0.000000" iyy="0.004391" ixz="0.000000" iyz="0.000000" izz="0.004277"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.025"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.025"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="pacecat_link">
    <!-- <material>red</material> -->
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
    <sensor type="gpu_lidar" name="pacecat_ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/pacecat/scan</topic>
      <gz_frame_id>pacecat_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>${radians(-180)}</min_angle>
            <max_angle>${radians( 180)}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.16</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- rear camera -->
  <!-- <xacro:include filename="$(find cube_petit_description)/xacro/sensors/camera.xacro" /> -->

  <!-- <xacro:brass_gazebo_battery_plugin parent_link="base_link" voltage="15.12" capacity_ah="2.0"
    charge_current="100.0" discharge_current="20.0"/>-->
  <joint name="left_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.000985 0.070150 0.0325"/>
    <parent link="body_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <!-- <limit effort="1000"/> -->
  </joint>
  <transmission name="left_wheel_trans" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="left_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
    <joint name="left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <link name="left_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00000147 0.00093592 -0.00000239"/>
      <mass value="0.2986774"/>
      <inertia ixx="0.0001147" ixy="0.00000000" iyy="0.0002130" ixz="0.00000000" iyz="0.0000001" izz="0.0001148"/>
    </inertial>
    <visual>
      <origin rpy="-1.57079632679 0 3.1415926" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find cube_petit_description)/meshes/cube_petit/wheels/tamiya_wheel.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 3.1415926" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.0325"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="left_wheel_link">
    <selfCollide>false</selfCollide>
    <maxContacts>2</maxContacts>
    <minDepth>0</minDepth>
    <!-- <dampingFactor>0</dampingFactor> -->
    <mu1 value="2.5"/>
    <kp value="50000"/>
    <kd value="0"/>
  </gazebo>


  <joint name="right_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.000985 -0.070150 0.0325"/>
    <parent link="body_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <!-- <limit effort="1000" velocity=""/> -->
  </joint>
  <transmission name="right_wheel_trans" type="SimpleTransmission">
    <type>transmission_interface/SimpleTransmission</type>
    <actuator name="right_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
    <joint name="right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <link name="right_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00000147 0.00093592 -0.00000239"/>
      <mass value="0.2986774"/>
      <inertia ixx="0.0001147" ixy="0.00000000" iyy="0.0002130" ixz="0.00000000" iyz="0.0000001" izz="0.0001148"/>
    </inertial>
    <visual>
      <origin rpy="1.57079632679 0 3.1415926" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find cube_petit_description)/meshes/cube_petit/wheels/tamiya_wheel.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 3.1415926" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.0325"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="right_wheel_link">
    <selfCollide>false</selfCollide>
    <maxContacts>2</maxContacts>
    <minDepth>0</minDepth>
    <!-- <dampingFactor>0</dampingFactor> -->
    <mu1 value="2.5"/>
    <kp value="50000"/>
    <kd value="0"/>
  </gazebo>

  <!-- camera -->
  <joint name="depth_joint" type="fixed">
    <parent link="body_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0.0034 0" xyz="0.10137 -0.006 0.097793"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00000000 0.00000000 0.0000000"/>
      <mass value="0.11166745"/>
      <inertia ixx="0.004391" ixy="0.000000" iyy="0.004391" ixz="0.000000" iyz="0.000000" izz="0.004277"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.001"/>
      </geometry>
      <!-- <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material> -->
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_rgb_optical_frame"/>
    <origin rpy="-1.57 0 -1.57" xyz="0.0 0.0 0.0"/>
  </joint>

  <link name="camera_rgb_optical_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00000000 0.00000000 0.0000000"/>
      <mass value="0.11166745"/>
      <inertia ixx="0.004391" ixy="0.000000" iyy="0.004391" ixz="0.000000" iyz="0.000000" izz="0.004277"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.001"/>
      </geometry>
      <!-- <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material> -->
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="depth_optical_joint" type="fixed">
    <parent link="camera_rgb_optical_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
  </joint>
  <link name="camera_depth_optical_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00000000 0.00000000 0.0000000"/>
      <mass value="0.11166745"/>
      <inertia ixx="0.004391" ixy="0.000000" iyy="0.004391" ixz="0.000000" iyz="0.000000" izz="0.004277"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.001"/>
      </geometry>
      <!-- <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material> -->
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.001"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="camera_link">
    <sensor type="depth" name="camera_depth_camera">
      <always_on>true</always_on>
      <update_rate>4.0</update_rate>
      <topic>camera/depth/image_raw</topic>
      <frame>camera_depth_optical_frame</frame>
      <camera>
        <camera_info_topic>camera/depth/camera_info</camera_info_topic>
        <horizontal_fov>${60.0*3.1415926/180.0}</horizontal_fov>
        <image>
          <format>R_FLOAT32</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.2</near>
          <far>1.5</far>
        </clip>
      </camera>
    </sensor>
    <sensor type="camera" name="camera_rgb_camera">
      <always_on>true</always_on>
      <update_rate>4.0</update_rate>
      <topic>camera/rgb/image_raw</topic>
      <frame>camera_rgb_optical_frame</frame>
      <camera>
        <camera_info_topic>camera/rgb/camera_info</camera_info_topic>
        <horizontal_fov>${60.0*3.1415926/180.0}</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.2</near>
          <far>1.5</far>
        </clip>
      </camera>
      <!-- <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
        <output_type>sensor_msgs/CameraInfo</output_type>
        <frame_name>rgb_optical_frame</frame_name>
      </plugin> -->
    </sensor>
  </gazebo>


  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-6</param>
        <param name="max">6</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-6</param>
        <param name="max">6</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find cube_petit_gazebo)/config/base_control_gazebo.yaml</parameters>
    </plugin>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
      <!-- <ros>
        <namespace>/cube_petit</namespace>
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>pacecat_link</frame_name> -->
    </plugin>

  </gazebo>
</robot>
