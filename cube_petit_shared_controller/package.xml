<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cube_petit_shared_controller</name>
  <version>0.0.0</version>
  <description>
    Lets one PS4 controller, physically paired to a single "hub" individual, drive whichever
    CubePetit individual is currently selected. The hub relays /joy-derived cmd_vel and the
    selected robot name over a plain zenoh session (no Bluetooth re-pairing needed); each
    individual's receiver node only drives its own diff_drive_controller while selected.
  </description>
  <maintainer email="SBGRP-git@g.softbank.co.jp">SoftBank corp.</maintainer>
  <license>Apache 2.0</license>
  <url type="repository">https://github.com/sbgisen/cube_petit_ros</url>
  <url type="bugtracker">https://github.com/sbgisen/cube_petit_ros/issues</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cube_petit_speech_msgs</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>cube_petit_bringup</exec_depend>

  <!--
    Same situation as cube_petit_fleet_bridge (see that package's package.xml comment): the
    plain "eclipse-zenoh" Python library used here has no rosdep key and is not pip installable
    in an externally managed environment (Ubuntu 24.04 / jazzy) without an explicit opt-in flag
    or a venv, so it is intentionally not listed as an exec_depend. See requirements.txt.
  -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
