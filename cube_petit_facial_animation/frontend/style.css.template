html, body {
  width: 100%;
  height: 100%;
  margin: 0;
  cursor: none;
  background-color: #ecf8fd;
}
html, body {
  overflow: hidden;
}
g, path {
  transform-box: fill-box;
  transform-origin: center;
}

.faceBox {
  width: 768px;
  height: 432px;
  position: absolute;
  display: none;
  z-index: 0;
  stroke: {{COLOR}};
  fill: {{COLOR}};
}

.emoji {
  position: absolute;
  bottom: 0;
  right: 0;
  transform-origin: bottom right;
  width: 280px;
  height: 280px;
  z-index: 1;
}
.emoji svg {
  width: 100%;
  fill: #1d2a45;
  display: none;
}
